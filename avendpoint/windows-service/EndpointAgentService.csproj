<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EndpointAgentService</AssemblyName>
    <RootNamespace>EndpointAgentService</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Endpoint Agent</Authors>
    <Product>Endpoint Agent Service</Product>
    <Description>Windows Service for managing the Endpoint Agent</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="7.0.0" />
  </ItemGroup>

</Project>
