generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Endpoint {
  id        String         @id @default(cuid())
  hostname  String         @unique
  osName    String
  lastSeen  DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  antivirus AntivirusInfo?
}

model AntivirusInfo {
  id String @id @default(cuid())

  endpointId String @unique

  productName String
  version     String?

  enabled Boolean
  
  quarantineCount Int @default(0)

  lastScan String?
  expiryDate DateTime?

  needsUpdate Boolean?

  endpoint Endpoint @relation(fields: [endpointId], references: [id])
}
