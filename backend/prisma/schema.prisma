generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Endpoint {
  id          Int       @id @default(autoincrement())

  hostname    String

  osName      String

  macAddress  String    @unique

  username    String?

  assetId     String?

  location    String?

  lastSeen    DateTime

  antivirus   Antivirus?
}

model Antivirus {
  id           Int       @id @default(autoincrement())

  productName  String

  version      String?

  enabled      Boolean

  lastScan     String?

  expiryDate   DateTime?

  endpointId   Int       @unique

  endpoint     Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}
